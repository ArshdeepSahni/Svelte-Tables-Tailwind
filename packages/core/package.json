{
  "name": "@tablecraft/core",
  "version": "0.0.1",
  "description": "Framework-agnostic core engine for @tablecraft — type inference, renderer registry, state management",
  "license": "MIT",
  "author": "Arshdeep Singh <arsh22sahni@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArshdeepSahni/Svelte-Tables-Tailwind",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./renderers/text": {
      "import": {
        "types": "./dist/renderers/text.d.ts",
        "default": "./dist/renderers/text.js"
      }
    },
    "./renderers/number": {
      "import": {
        "types": "./dist/renderers/number.d.ts",
        "default": "./dist/renderers/number.js"
      }
    },
    "./renderers/integer": {
      "import": {
        "types": "./dist/renderers/integer.d.ts",
        "default": "./dist/renderers/integer.js"
      }
    },
    "./renderers/currency": {
      "import": {
        "types": "./dist/renderers/currency.d.ts",
        "default": "./dist/renderers/currency.js"
      }
    },
    "./renderers/percentage": {
      "import": {
        "types": "./dist/renderers/percentage.d.ts",
        "default": "./dist/renderers/percentage.js"
      }
    },
    "./renderers/boolean": {
      "import": {
        "types": "./dist/renderers/boolean.d.ts",
        "default": "./dist/renderers/boolean.js"
      }
    },
    "./renderers/date": {
      "import": {
        "types": "./dist/renderers/date.d.ts",
        "default": "./dist/renderers/date.js"
      }
    },
    "./renderers/datetime": {
      "import": {
        "types": "./dist/renderers/datetime.d.ts",
        "default": "./dist/renderers/datetime.js"
      }
    },
    "./renderers/time": {
      "import": {
        "types": "./dist/renderers/time.d.ts",
        "default": "./dist/renderers/time.js"
      }
    },
    "./renderers/email": {
      "import": {
        "types": "./dist/renderers/email.d.ts",
        "default": "./dist/renderers/email.js"
      }
    },
    "./renderers/url": {
      "import": {
        "types": "./dist/renderers/url.d.ts",
        "default": "./dist/renderers/url.js"
      }
    },
    "./renderers/phone": {
      "import": {
        "types": "./dist/renderers/phone.d.ts",
        "default": "./dist/renderers/phone.js"
      }
    },
    "./renderers/image": {
      "import": {
        "types": "./dist/renderers/image.d.ts",
        "default": "./dist/renderers/image.js"
      }
    },
    "./renderers/badge": {
      "import": {
        "types": "./dist/renderers/badge.d.ts",
        "default": "./dist/renderers/badge.js"
      }
    },
    "./renderers/status": {
      "import": {
        "types": "./dist/renderers/status.d.ts",
        "default": "./dist/renderers/status.js"
      }
    },
    "./renderers/code": {
      "import": {
        "types": "./dist/renderers/code.d.ts",
        "default": "./dist/renderers/code.js"
      }
    },
    "./renderers/html": {
      "import": {
        "types": "./dist/renderers/html.d.ts",
        "default": "./dist/renderers/html.js"
      }
    }
  },
  "peerDependencies": {
    "dompurify": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "dompurify": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.0",
    "typescript": "^5.8.3",
    "vite": "^8.0.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.0"
  },
  "keywords": [
    "tablecraft",
    "table",
    "data-grid",
    "typescript",
    "framework-agnostic"
  ]
}
