{
  "name": "@tablecraft/core",
  "version": "0.0.1",
  "description": "Framework-agnostic core engine for @tablecraft — type inference, renderer registry, state management",
  "license": "MIT",
  "author": "Arshdeep Singh <arsh22sahni@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArshdeepSahni/Svelte-Tables-Tailwind",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^8.0.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.0"
  },
  "keywords": [
    "tablecraft",
    "table",
    "data-grid",
    "typescript",
    "framework-agnostic"
  ]
}
