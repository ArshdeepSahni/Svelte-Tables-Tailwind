{
  "name": "tablecraft-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "pnpm monorepo for @tablecraft/* packages",
  "license": "MIT",
  "author": "Arshdeep Singh <arsh22sahni@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArshdeepSahni/Svelte-Tables-Tailwind"
  },
  "engines": {
    "node": ">=20.19.0 || >=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm -r build && changeset publish",
    "clean": "pnpm -r --parallel exec rm -rf dist .svelte-kit build"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@eslint/js": "^9.24.0",
    "@playwright/test": "^1.50.1",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@testing-library/svelte": "^5.2.7",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "eslint": "^9.24.0",
    "eslint-plugin-svelte": "^2.46.1",
    "globals": "^16.0.0",
    "jsdom": "^29.0.1",
    "playwright": "^1.50.1",
    "prettier": "^3.5.3",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.0.0",
    "svelte-eslint-parser": "^0.43.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.0"
  },
  "pnpm": {
    "overrides": {}
  }
}
